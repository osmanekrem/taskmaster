{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@taskmaster/validation": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@osmanekrem/error-handler": "^1.2.1",
    "@trpc/client": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "better-auth": "^1.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.6",
    "resend": "^6.5.2",
    "superjson": "^2.2.5",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.3",
    "drizzle-kit": "^0.31.7",
    "@types/ws": "^8.18.1"
  }
}
